NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Neon pooled connection (runtime queries)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Neon direct connection (migrations, COPY — not the pooler host)
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: Neon test branch for doctor / integration tests
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-test.region.aws.neon.tech/neondb?sslmode=require