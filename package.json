{
	"name": "product",
	"version": "1.0.0",
	"description": "AST-based code smell analysis API",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"build": "tsc --noEmit false --outDir dist",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"setup": "node --input-type=module -e \"import { copyFileSync, existsSync } from 'node:fs'; if (!existsSync('.env')) copyFileSync('.env.example', '.env');\"",
		"doctor": "tsx scripts/doctor.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.30.3",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"tree-sitter",
			"tree-sitter-javascript",
			"tree-sitter-typescript"
		]
	},
	"dependencies": {
		"dotenv": "^18.0.10",
		"drizzle-orm": "^0.45.4",
		"express": "^5.3.0",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"pino-http": "^11.0.0",
		"tree-sitter": "^0.25.1",
		"tree-sitter-javascript": "^0.25.0",
		"tree-sitter-typescript": "^0.23.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"pino-pretty": "^13.2.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^5.1.1"
	}
}
